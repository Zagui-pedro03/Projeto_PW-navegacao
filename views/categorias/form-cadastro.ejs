<%- include("../partials/header") %> <%- include("../partials/nav") %>

<link rel="stylesheet" href="/css/form.css" />
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
/>

<div class="categoria-container">
  <div class="categoria-card">
    <!-- Cabeçalho -->
    <div class="categoria-header">
      <div class="categoria-icon">
        <i class="bi bi-tags"></i>
      </div>

      <div>
        <h2>Nova Categoria</h2>
        <p>Organize seus eletrônicos por categoria</p>
      </div>
    </div>

    <!-- Formulário -->
    <div class="categoria-body">
      <form action="/categorias" method="POST">
        <div class="form-group">
          <label for="nome">
            Nome da categoria
            <span class="required">*</span>
          </label>

          <input
            type="text"
            class="categoria-input"
            id="nome"
            name="nome"
            placeholder="Ex: Smartphones, Notebooks..."
            required
          />

          <small>Informe um nome claro e fácil de identificar.</small>
        </div>

        <div class="form-group">
          <label for="descricao"> Descrição </label>

          <textarea
            class="categoria-input categoria-textarea"
            id="descricao"
            name="descricao"
            rows="4"
            placeholder="Descreva brevemente essa categoria..."
          ></textarea>

          <small>Campo opcional para informações adicionais.</small>
        </div>

        <!-- Botões -->
        <div class="categoria-actions">
          <a href="/categorias" class="btn-cancelar">
            <i class="bi bi-arrow-left"></i>
            Cancelar
          </a>

          <button type="submit" class="btn-cadastrar">
            <i class="bi bi-plus-lg"></i>
            Cadastrar categoria
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>