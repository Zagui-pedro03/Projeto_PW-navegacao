<%- include("../partials/header") %>
<%- include("../partials/nav") %>
<link rel="stylesheet" href="/css/form.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<main class="categoria-container">
  <div class="categoria-card">
    <div class="categoria-header">
      <div class="categoria-icon"><i class="bi bi-tags"></i></div>
      <div><h2>Editar Categoria</h2><p>Atualize as informações cadastradas</p></div>
    </div>
    <div class="categoria-body">
      <form action="" method="POST">
      <div class="form-group">
        <label for="nome">Nome</label>
        <input type="text" class="categoria-input" id="nome" name="nome" placeholder="Digite o nome da categoria" value="<%= categoria.nome %>" />
      </div>

      <div class="form-group">
        <label for="descricao">Descrição</label>
        <textarea class="categoria-input categoria-textarea" id="descricao" name="descricao" rows="4" placeholder="Descreva brevemente esta categoria..."><%= categoria.descricao %></textarea>
      </div>

        <div class="categoria-actions">
          <a href="/categorias" class="btn-cancelar"><i class="bi bi-arrow-left"></i> Cancelar</a>
          <button type="submit" class="btn-cadastrar"><i class="bi bi-check-lg"></i> Atualizar Categoria</button>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include("../partials/footer") %>
