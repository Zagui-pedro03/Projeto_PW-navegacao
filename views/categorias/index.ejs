<%- include("../partials/header") %>
<%- include("../partials/nav") %>
<link rel="stylesheet" href="/css/indexCategoria.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<main class="categorias-container">
  <div class="categorias-topo">
    <div class="categorias-titulo">
      <div class="categorias-icon"><i class="bi bi-tags"></i></div>
      <div>
        <h2>Categorias</h2>
        <p>Lista de categorias cadastradas</p>
      </div>
    </div>
    <a href="/categorias/cadastro" class="btn-nova-categoria">
      <i class="bi bi-plus-lg"></i> Nova Categoria
    </a>
  </div>

  <section class="categorias-card">
    <header class="categorias-card-header">
      <div>
        <h5>Categorias cadastrados</h5>
        <p>Visualize e gerencie os registros do sistema</p>
      </div>
      <span class="categorias-badge"><i class="bi bi-tags"></i> <%= categorias.length %> cadastrados</span>
    </header>

    <% if (categorias.length > 0) { %>
    <div class="categorias-table-container">
      <table class="categorias-table">
        <thead><tr><th class="col-id">ID</th><th>Nome</th><th>Descrição</th><th class="col-acoes">Opções</th></tr></thead>
        <tbody>
          <% categorias.forEach(mostrar => { %>
          <tr>
            <td><span class="categoria-id"><%= mostrar.id %></span></td>
            <td><span class="categoria-nome"><span class="categoria-nome-icon"><i class="bi bi-tag"></i></span><%= mostrar.nome %></span></td>
            <td><span class="categoria-descricao"><%= mostrar.descricao %></span></td>
            <td>
              <div class="categoria-opcoes">
                <a class="btn-editar" href="/categorias/editar/<%= mostrar.id %>" onclick="return confirm('Deseja editar esta categoria?')"><i class="bi bi-pencil-square"></i> Editar</a>
                <a class="btn-excluir" href="/categorias/excluir/<%= mostrar.id %>" onclick="return confirm('Deseja excluir esta categoria?')"><i class="bi bi-trash"></i> Excluir</a>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="categorias-vazio">
      <i class="bi bi-tags"></i>
      <h5>Nenhum categoria cadastrado</h5>
      <p>Cadastre uma nova categoria para começar a organizar os registros.</p>
      <a href="/categorias/cadastro" class="btn-nova-categoria"><i class="bi bi-plus-lg"></i> Nova Categoria</a>
    </div>
    <% } %>

    <footer class="categorias-card-footer"><i class="bi bi-info-circle"></i> Categorias registrados no sistema</footer>
  </section>
</main>

<%- include("../partials/footer") %>
