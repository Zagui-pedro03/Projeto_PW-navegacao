<%- include("../partials/header") %>
<%- include("../partials/nav") %>
<link rel="stylesheet" href="/css/formFornecedor.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<main class="fornecedor-container">
  <div class="fornecedor-card">
    <div class="fornecedor-header">
      <div class="fornecedor-icon"><i class="bi bi-truck"></i></div>
      <div><h2>Novo Fornecedor</h2><p>Preencha as informações para cadastrar</p></div>
    </div>
    <div class="fornecedor-body">
      <form action="/fornecedores" method="POST">
      <div class="form-group">
        <label for="cnpj">CNPJ</label>
        <input type="text" class="fornecedor-input" id="cnpj" name="cnpj" placeholder="Digite o CNPJ" />
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" class="fornecedor-input" id="email" name="email" placeholder="Digite o email" />
      </div>

        <div class="fornecedor-actions">
          <a href="/fornecedores" class="btn-cancelar"><i class="bi bi-arrow-left"></i> Cancelar</a>
          <button type="submit" class="btn-cadastrar"><i class="bi bi-plus-lg"></i> Cadastrar fornecedor</button>
        </div>
      </form>
    </div>
  </div>
</main>
<% if (erro) { %>
<script>alert("<%= erro %>");</script>
<% } %>

<%- include("../partials/footer") %>
