<%- include("../partials/header") %>
<%- include("../partials/nav") %>
<link rel="stylesheet" href="/css/indexProduto.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<main class="produtos-container">
  <div class="produtos-topo">
    <div class="produtos-titulo">
      <div class="produtos-icon"><i class="bi bi-box-seam"></i></div>
      <div>
        <h2>Produtos</h2>
        <p>Lista de produtos cadastrados</p>
      </div>
    </div>
    <a href="/produtos/cadastro" class="btn-nova-produto">
      <i class="bi bi-plus-lg"></i> Novo Produto
    </a>
  </div>

  <section class="produtos-card">
    <header class="produtos-card-header">
      <div>
        <h5>Produtos cadastrados</h5>
        <p>Visualize e gerencie os registros do sistema</p>
      </div>
      <span class="produtos-badge"><i class="bi bi-box-seam"></i> <%= produtos.length %> cadastrados</span>
    </header>

    <% if (produtos.length > 0) { %>
    <div class="produtos-table-container">
      <table class="produtos-table">
        <thead><tr><th class="col-id">ID</th><th>Nome</th><th>Preço</th><th class="col-acoes">Opções</th></tr></thead>
        <tbody>
          <% produtos.forEach(mostrar => { %>
          <tr>
            <td><span class="produto-id"><%= mostrar.id %></span></td>
            <td><span class="produto-nome"><span class="produto-nome-icon"><i class="bi bi-box"></i></span><%= mostrar.nome %></span></td>
            <td><span class="produto-descricao"><%= mostrar.preco %></span></td>
            <td>
              <div class="produto-opcoes">
                <a class="btn-editar" href="/produtos/editar/<%= mostrar.id %>" onclick="return confirm('Deseja editar este produto?')"><i class="bi bi-pencil-square"></i> Editar</a>
                <a class="btn-excluir" href="/produtos/excluir/<%= mostrar.id %>" onclick="return confirm('Deseja excluir este produto?')"><i class="bi bi-trash"></i> Excluir</a>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="produtos-vazio">
      <i class="bi bi-box-seam"></i>
      <h5>Nenhum produto cadastrado</h5>
      <p>Cadastre um novo produto para começar a organizar os registros.</p>
      <a href="/produtos/cadastro" class="btn-nova-produto"><i class="bi bi-plus-lg"></i> Novo Produto</a>
    </div>
    <% } %>

    <footer class="produtos-card-footer"><i class="bi bi-info-circle"></i> Produtos registrados no sistema</footer>
  </section>
</main>

<%- include("../partials/footer") %>
