<%- include("../partials/header") %>
<%- include("../partials/nav") %>
<link rel="stylesheet" href="/css/indexCliente.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<main class="clientes-container">
  <div class="clientes-topo">
    <div class="clientes-titulo">
      <div class="clientes-icon"><i class="bi bi-people"></i></div>
      <div>
        <h2>Clientes</h2>
        <p>Lista de clientes cadastrados</p>
      </div>
    </div>
    <a href="/clientes/cadastro" class="btn-nova-cliente">
      <i class="bi bi-plus-lg"></i> Novo Cliente
    </a>
  </div>

  <section class="clientes-card">
    <header class="clientes-card-header">
      <div>
        <h5>Clientes cadastrados</h5>
        <p>Visualize e gerencie os registros do sistema</p>
      </div>
      <span class="clientes-badge"><i class="bi bi-people"></i> <%= clientes.length %> cadastrados</span>
    </header>

    <% if (clientes.length > 0) { %>
    <div class="clientes-table-container">
      <table class="clientes-table">
        <thead><tr><th class="col-id">ID</th><th>Nome</th><th>Email</th><th class="col-acoes">Opções</th></tr></thead>
        <tbody>
          <% clientes.forEach(mostrar => { %>
          <tr>
            <td><span class="cliente-id"><%= mostrar.id %></span></td>
            <td><span class="cliente-nome"><span class="cliente-nome-icon"><i class="bi bi-person"></i></span><%= mostrar.nome %></span></td>
            <td><span class="cliente-descricao"><%= mostrar.email %></span></td>
            <td>
              <div class="cliente-opcoes">
                <a class="btn-editar" href="/clientes/editar/<%= mostrar.id %>" onclick="return confirm('Deseja editar este cliente?')"><i class="bi bi-pencil-square"></i> Editar</a>
                <a class="btn-excluir" href="/clientes/excluir/<%= mostrar.id %>" onclick="return confirm('Deseja excluir este cliente?')"><i class="bi bi-trash"></i> Excluir</a>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="clientes-vazio">
      <i class="bi bi-people"></i>
      <h5>Nenhum cliente cadastrado</h5>
      <p>Cadastre um novo cliente para começar a organizar os registros.</p>
      <a href="/clientes/cadastro" class="btn-nova-cliente"><i class="bi bi-plus-lg"></i> Novo Cliente</a>
    </div>
    <% } %>

    <footer class="clientes-card-footer"><i class="bi bi-info-circle"></i> Clientes registrados no sistema</footer>
  </section>
</main>

<%- include("../partials/footer") %>
